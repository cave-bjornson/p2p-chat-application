<Window
  x:Class="ChatApp.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ChatApp"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Log in"
  Width="300"
  Height="450"
  Icon="pack://application:,,,/Images/icon.ico"
  mc:Ignorable="d"
>
  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="40" />
      <RowDefinition Height="40" />
      <RowDefinition Height="40" />
      <RowDefinition Height="40" />
      <RowDefinition Height="40" />
      <RowDefinition Height="60" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Label
      Grid.Row="1"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Content="Name:"
      FontSize="20"
    />
    <TextBox
      Grid.Row="2"
      Width="150"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      FontSize="20"
      Style="{StaticResource RoundedTextBox}"
      Text="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      TextWrapping="Wrap"
    />
    <Label
      Grid.Row="3"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Content="Port:"
      FontSize="20"
    />
    <TextBox
      Grid.Row="4"
      Width="150"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      FontSize="20"
      Style="{StaticResource RoundedTextBox}"
      Text="{Binding Path=Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      TextWrapping="Wrap"
    >
      <TextBox.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding Path=StartClient}" />
      </TextBox.InputBindings>
    </TextBox>
    <ComboBox
      Grid.Row="5"
      Width="150"
      Height="30"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      FontSize="20"
      IsEditable="True"
      IsReadOnly="False"
      ItemsSource="{Binding IpAddresses}"
      Text="{Binding Path=SelectedIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    />
    <Border
      Grid.Row="6"
      Width="150"
      Height="40"
      HorizontalAlignment="Center"
      Background="{StaticResource AccentBrush3}"
      CornerRadius="10"
    >
      <Button
        Grid.Row="7"
        Width="150"
        Height="40"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Command="{Binding Path=StartClient}"
        Content="Start client"
        FontSize="20"
        Style="{StaticResource HoverButton}"
      />
    </Border>
    <TextBlock
      Grid.Row="8"
      Margin="15"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      FontWeight="Bold"
      Foreground="{StaticResource DeclineBrush}"
      Text="{Binding Path=ErrorMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
      TextAlignment="Center"
      TextWrapping="Wrap"
    />
  </Grid>
</Window>
